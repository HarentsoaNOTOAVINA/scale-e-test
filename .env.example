# ==============================================================================
# Scal-e CDP Backend - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Scal-e CDP Backend"
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080
API_KEY=scal-e-secret-key-2026-dev

# Database Configuration (MySQL 8.0)
# - If running locally with PHP CLI: use DB_HOST=127.0.0.1
# - If running inside Docker: DB_HOST=db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scal_e_cdp
DB_USER=root
DB_PASS=root_password

# Redis Configuration (Optional / Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
